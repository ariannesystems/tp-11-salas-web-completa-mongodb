<section class="tarjeta-principal">  
    <p class="etiqueta">EDICIÓN</p>
    <hr>
    <h1><%= titulo %></h1>  
    <% if (error) { %>    
        <p class="error" role="alert"> <%= error %></p>
    <% } %>  
    <form action="/reservas/<%= id %>/editar" method="post" class="formulario">
        <label for="estudiante">Estudiante</label>
        <input id="estudiante" name="estudiante" value="<%= valores.estudiante %>" required>

        <label for="email">Email</label>
        <input id="email" name="email" value="<%= valores.email %>" required>   
        
        <label for="sala">Sala</label>
        <select id="sala" name="sala" required>
            <option value="" <%= !["Sala Norte", "Sala Sur", "Sala Multimedia"].includes(valores.sala) ? "selected" : "" %>>Seleccione una sala</option>
            <option value="Sala Norte" <%= valores.sala === 'Sala Norte' ? 'selected' : '' %>>Sala Norte</option>
            <option value="Sala Sur" <%= valores.sala === 'Sala Sur' ? 'selected' : '' %>>Sala Sur</option>
            <option value="Sala Multimedia" <%= valores.sala === 'Adoptada' ? 'selected' : '' %>>Sala Multimedia</option>
        </select>

        <label for="fecha">Fecha</label>
        <input type="date" id="fecha" name="fecha" value="<%= valores.fecha %>" required>

        <label for="turno">Turno</label>
        <select id="turno" name="turno" required>
            <option value="" <%= !["Mañana", "Tarde", "Noche"].includes(valores.turno) ? "selected" : "" %>>Seleccione un turno</option>
            <option value="Mañana" <%= valores.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
            <option value="Tarde" <%= valores.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
            <option value="Noche" <%= valores.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
        </select>

        <label for="personas">Cantidad de personas</label>
        <input id="personas" name="personas" type="number" min="1" max="6" step="1" value="<%= valores.personas %>" required>

        <label for="disponible">Estado</label>    
        <select id="estado" name="estado" required>      
            <option value="" <%= !["pendiente", "confirmada"].includes(valores.estado) ? "selected" : "" %>>Elegí una opción</option>      
            <option value="pendiente" <%= valores.estado === "pendiente" ? "selected" : "" %>>Pendiente</option>      
            <option value="confirmada" <%= valores.estado === "confirmada" ? "selected" : "" %>>Confirmada</option>    
        </select>
        <hr>
        <div>
            <button type="submit">Guardar cambios</button>
            <button type="button" onclick="location.href='/reservas/<%= id %>'">Cancelar y volver al detalle</button>
            <!--<a href="/reservas/<%= id %>">Cancelar y volver al detalle</a>  -->
        </div>
    </form>  
</section>